{
  "name": "officina-3d",
  "version": "0.1.0",
  "description": "Macchine da officina in 3D da ruotare, sezionare e smontare nel browser. Prima macchina: equilibratrice per ruote auto.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Alessandro Pezzali",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node tools/icons.mjs",
    "verifica": "vite build --ssr tools/verifica.ts --outDir .verifica --emptyOutDir --logLevel warn && node .verifica/verifica.js"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
